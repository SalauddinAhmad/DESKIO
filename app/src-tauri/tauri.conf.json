{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BHUninstaller",
  "version": "0.1.0",
  "identifier": "com.biswashost.bhuninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BHUninstaller",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Utility",
    "shortDescription": "Uninstall apps and clean up what they leave behind.",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
