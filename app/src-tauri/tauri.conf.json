{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskio",
  "version": "1.0.0",
  "identifier": "com.deskio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deskio",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Organize. Clean. Simplify.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "publisher": "Deskio Team",
    "homepage": "https://github.com/deskio/deskio",
    "longDescription": "Deskio — Organize. Clean. Simplify. Uninstall applications thoroughly, sweep developer build junk (node_modules, Cargo targets, Xcode caches), and reclaim your disk space with total safety."
  }
}
